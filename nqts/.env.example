# NestQuant runtime configuration (all optional; defaults derived from repo root)

# Paths
NQTS_DATA_DIR=/path/to/data
NQTS_LOG_DIR=/path/to/logs
ACCOUNTS_YAML=/path/to/accounts.yaml
MT5_PATH=

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_SECRET=change-me-min-16-chars

# Alerting / Notifications
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=ntfy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# News calendar
NEWS_CSV_PATH=

# Logging
LOG_LEVEL=INFO
NQTS_JSON_LOGS=false

# Multi-account execution
LIVE_LOG_DIR=
